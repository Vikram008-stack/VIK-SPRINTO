# Copy to .env and fill in. .env is gitignored - never commit it, never paste keys in chat.
SCRAPINGBEE_API_KEY=
GEMINI_API_KEY=
HUNTER_API_KEY=
# Only needed when search.provider = serper
SEARCH_API_KEY=
# Gmail OAuth (Desktop app client). Files live under data/secrets/ (gitignored).
GMAIL_CLIENT_SECRET_FILE=data/secrets/client_secret.json
GMAIL_TOKEN_FILE=data/secrets/token.json
# The ONLY address this build will ever send to.
DEMO_RECIPIENT_EMAIL=
