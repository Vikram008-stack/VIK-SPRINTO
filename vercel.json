{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{src/**,config/**,tests/fixtures/**,public/desk.css,public/desk.js}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
